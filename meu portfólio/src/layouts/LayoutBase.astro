---
/**
 * LayoutBase.astro — Layout raiz
 *
 * Responsável apenas por estrutura HTML global:
 * - <html> com lang e dir corretos
 * - <head> com SEO, fontes e estilos globais
 * - Slot principal para conteúdo
 *
 * Nunca contém conteúdo de página.
 */

import type { SEOMeta } from '@types/seo';
import type { Locale } from '@config/site';
import { SITE } from '@config/site';

interface Props {
  seo: SEOMeta;
  locale?: Locale;
}

const { seo, locale = 'pt' } = Astro.props;

const lang = locale === 'pt' ? 'pt-BR' : 'en-US';
const pageTitle = seo.title ? `${seo.title} — ${SITE.name}` : SITE.title;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO básico -->
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description ?? SITE.description} />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={seo.ogType ?? 'website'} />
    <meta property="og:title" content={seo.ogTitle ?? pageTitle} />
    <meta property="og:description" content={seo.ogDescription ?? seo.description ?? SITE.description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={seo.twitterCard ?? 'summary_large_image'} />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={seo.twitterTitle ?? pageTitle} />
    <meta name="twitter:description" content={seo.twitterDescription ?? seo.description ?? SITE.description} />
    {seo.twitterImage && <meta name="twitter:image" content={seo.twitterImage} />}

    <!-- Fontes — preconnect e preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicons/favicon.png" />

    <!-- Estilos globais -->
    <link rel="stylesheet" href="/styles/global.css" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <!-- Slot para meta tags adicionais por página -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
