---
/**
 * LayoutLanding.astro — Layout da Home
 *
 * Usado por: / (home) e /en.
 * Sem sidebar. Máxima liberdade compositiva.
 * Hero editorial de tela cheia seguido de seções.
 */

import LayoutBase from './LayoutBase.astro';
import type { SEOMeta } from '@types/seo';
import type { Locale } from '@config/site';

interface Props {
  seo: SEOMeta;
  locale?: Locale;
}

const { seo, locale = 'pt' } = Astro.props;
---

<LayoutBase seo={seo} locale={locale}>
  <slot name="head" slot="head" />

  <!-- Header overlay — implementado na Etapa 4 -->
  <!-- <Header locale={locale} overlay={true} /> -->

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <!-- Footer — implementado na Etapa 4 -->
  <!-- <Footer locale={locale} /> -->
</LayoutBase>
