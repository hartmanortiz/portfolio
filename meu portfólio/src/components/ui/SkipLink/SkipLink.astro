---
/**
 * SkipLink
 * Componente de acessibilidade para pular diretamente para o conteúdo principal.
 * WCAG 2.2 — Critério 2.4.1 (Bypass Blocks)
 */

import "./SkipLink.css"
import type { SkipLinkProps } from "./SkipLink.ts"

const {
  targetId = "main-content",
  lang     = "pt",
  label,
} = Astro.props as SkipLinkProps

const defaultLabel = lang === "pt" ? "Ir para o conteúdo principal" : "Skip to main content"
const text = label ?? defaultLabel
---

<a href={`#${targetId}`} class="skip-link">
  {text}
</a>
