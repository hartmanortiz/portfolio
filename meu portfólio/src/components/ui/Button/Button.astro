---
/**
 * Button
 * Elemento interativo discreto.
 *
 * "Poucos. Muito discretos. Sem aparência tecnológica."
 * — docs/02-design-system.md §18
 *
 * Renderiza <a> quando `href` é fornecido.
 * Renderiza <button> caso contrário.
 */

import type { ButtonProps } from "./Button.ts"

const {
  variant = "default",
  size    = "md",
  href,
  type    = "button",
  disabled = false,
  label,
  external = false,
} = Astro.props as ButtonProps

const Tag    = href ? "a" : "button"
const cls    = `btn btn--${variant} btn--${size}`
const target = external ? "_blank" : undefined
const rel    = external ? "noopener noreferrer" : undefined
---

{href ? (
  <a
    href={href}
    class={cls}
    target={target}
    rel={rel}
    aria-label={external ? `${label} (abre em nova aba)` : undefined}
  >
    <slot>{label}</slot>
    {external && <span class="btn__external" aria-hidden="true">↗</span>}
  </a>
) : (
  <button
    type={type}
    class={cls}
    disabled={disabled}
    aria-disabled={disabled}
  >
    <slot>{label}</slot>
  </button>
)}
