---
/**
 * Heading
 * Título semântico com controle de família tipográfica.
 *
 * Renderiza o elemento HTML correto (h1–h4)
 * com os tokens de tipografia aplicados.
 *
 * Fonte: docs/02-design-system.md — §8, §9
 */

import type { HeadingProps } from "./Typography.ts"

const {
  as:     Tag    = "h2",
  family         = "editorial",
  class: classes = "",
} = Astro.props as HeadingProps
---

<Tag class={`heading heading--${Tag} heading--${family} ${classes}`}>
  <slot />
</Tag>
