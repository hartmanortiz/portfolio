---
/**
 * Footer
 * Rodapé editorial do portfólio.
 * Discreto. Créditos, idioma, links essenciais.
 *
 * Fonte: docs/02-design-system.md — §15
 */

import "./Footer.css"
import type { FooterProps } from "./Footer.ts"

const { lang } = Astro.props as FooterProps

const year = new Date().getFullYear()

const copy = {
  pt: {
    rights:  "Todos os direitos reservados.",
    archive: "Arquivo",
    about:   "Sobre",
    contact: "Contato",
    lang:    "EN",
    langHref: "/en/",
    langLabel: "View in English",
  },
  en: {
    rights:  "All rights reserved.",
    archive: "Archive",
    about:   "About",
    contact: "Contact",
    lang:    "PT",
    langHref: "/",
    langLabel: "Ver em Português",
  },
} as const

const t = copy[lang]
---

<footer class="footer">
  <div class="footer__inner">

    <!-- Identidade e crédito -->
    <div class="footer__credit">
      <span class="footer__name">Hartman Ortiz</span>
      <time class="footer__year" datetime={String(year)}>{year}</time>
    </div>

    <!-- Links essenciais -->
    <nav class="footer__nav" aria-label={lang === "pt" ? "Links do rodapé" : "Footer links"}>
      <a href={lang === "pt" ? "/arquivo/"   : "/en/archive/"}  class="footer__link">{t.archive}</a>
      <a href={lang === "pt" ? "/sobre/"     : "/en/about/"}    class="footer__link">{t.about}</a>
      <a href={lang === "pt" ? "/contato/"   : "/en/contact/"}  class="footer__link">{t.contact}</a>
    </nav>

    <!-- Idioma e direitos -->
    <div class="footer__meta">
      <a
        href={t.langHref}
        class="footer__lang"
        hreflang={lang === "pt" ? "en" : "pt"}
        aria-label={t.langLabel}
      >
        {t.lang}
      </a>
      <span class="footer__rights">{t.rights}</span>
    </div>

  </div>
</footer>
