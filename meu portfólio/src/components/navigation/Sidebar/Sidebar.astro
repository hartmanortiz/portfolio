---
/**
 * Sidebar
 * Painel lateral de conteúdo contextual.
 *
 * Uso: metadados de projeto, notas de processo,
 *      informações complementares.
 *
 * No desktop: coluna lateral fixa ao lado do conteúdo.
 * No mobile:  bloco inline, abaixo do conteúdo principal.
 *
 * Não confundir com o Header (navegação principal).
 * Este é um sidebar de CONTEÚDO, não de navegação.
 *
 * Fonte: docs/02-design-system.md — §14 (Notas de Processo)
 *        docs/05-software-architecture.md — §21 (ResearchNotes)
 */

import "./Sidebar.css"
import type { SidebarProps } from "./Sidebar.ts"

const {
  lang     = "pt",
  position = "right",
} = Astro.props as SidebarProps
---

<aside
  class={`sidebar sidebar--${position}`}
  aria-label={lang === "pt" ? "Informações complementares" : "Additional information"}
>
  <div class="sidebar__inner">
    <slot />
  </div>
</aside>
